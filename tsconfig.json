{
  "compilerOptions": {
    // Stated explicitly rather than inherited: TypeScript 6 turned this on by
    // default, and pinning it keeps the checking level from shifting on upgrade.
    "strict": true,
    // Enable top-level await, and other modern ESM features.
    "target": "ESNext",
    "module": "ESNext",
    // Bundler resolution is required to resolve Astro's subpath exports
    // (e.g. "astro/loaders") from their package.json "exports" map.
    "moduleResolution": "bundler",
    // Enable JSON imports.
    "resolveJsonModule": true,
    // Enable stricter transpilation for better output.
    "isolatedModules": true,
    // Add type definitions for our Astro runtime.
    "types": ["astro/client"],
    "allowSyntheticDefaultImports": true
  }
}
